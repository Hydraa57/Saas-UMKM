# Salin berkas ini menjadi .env.local dan isi dari dasbor proyek Supabase
# (Settings → API).
#
# Hanya kunci publik yang boleh ada di sini. Kunci service_role
# mem-bypass RLS sepenuhnya dan tidak boleh pernah masuk ke variabel
# ber-awalan NEXT_PUBLIC_, karena semua yang berawalan itu ikut terkirim
# ke perangkat pengguna.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
