# Salin berkas ini menjadi .env.local dan isi dari dasbor proyek Supabase
# (Project Settings → API Keys).
#
# Kunci publishable memang ikut terkirim ke perangkat pengguna, dan itu
# tidak apa-apa: yang menjaga datanya adalah RLS, bukan kerahasiaan kunci.
#
# Yang **tidak boleh** ada di sini: `service_role`. Ia mem-bypass RLS
# sepenuhnya, jadi tempatnya hanya di route server atau Edge Function —
# tidak pernah di variabel berawalan NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Proyek Supabase lama menamai kunci ini `NEXT_PUBLIC_SUPABASE_ANON_KEY`.
# Nama itu juga diterima, jadi tidak perlu diganti kalau sudah terpasang.
